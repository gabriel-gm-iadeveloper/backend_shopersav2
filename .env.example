# Configuración de Base de Datos
DB_URL=jdbc:mysql://localhost:3306/bdshopersa?serverTimezone=UTC&useSSL=false
DB_USERNAME=root
DB_PASSWORD=

# Configuración de JPA/Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Configuración de Uploads
UPLOADS_MAX_FILE_SIZE=10MB
UPLOADS_MAX_REQUEST_SIZE=10MB
UPLOADS_PRODUCTS_DIR=uploads/products

# Configuración de Seguridad JWT
JWT_SECRET=mySecretKey
JWT_EXPIRATION=86400000

# Configuración del Seed de Datos
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@shopersa.cl
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NOMBRES=Administrador
SEED_ADMIN_APELLIDOS=Sistema

# Configuración de CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Configuración de Logging
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_ROOT=INFO