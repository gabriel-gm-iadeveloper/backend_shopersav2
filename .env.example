
# Database configuration
DB_URL=jdbc:mysql://localhost:3306/bd_shopersa?serverTimezone=UTC&useSSL=false
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# File uploads
UPLOADS_MAX_FILE_SIZE=10MB
UPLOADS_MAX_REQUEST_SIZE=10MB
UPLOADS_PRODUCTS_DIR=uploads/products

# JWT Security
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION=86400000

# Initial administrator
SEED_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRES=Administrador
SEED_ADMIN_APELLIDOS=Sistema

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_ROOT=INFO
